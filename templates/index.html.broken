                <!-- 鐘舵€佹秷鎭?-->
                <div class="status-message" id="pipeline-message"></div>

                <!-- 鍙傛暟閰嶇疆琛ㄥ崟 -->
                <div class="step-grid" style="gap: 1.25rem;">

                    <!-- 鈹€鈹€ 鍩虹璺緞閰嶇疆 鈹€鈹€ -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                鍩虹璺緞閰嶇疆
                            </h3>
                        </div>
                        <div class="form-group">
                            <label class="form-label">褰卞儚鏂囦欢澶硅矾寰?<span class="badge-required">蹇呭～</span></label>
                            <div class="input-with-btn">
                                <input type="text" id="pipeline-input-img-dir" class="form-input" placeholder="鍖呭惈 .tif/.tiff/.img 褰卞儚鏂囦欢鐨勬枃浠跺す">
                                <button type="button" class="btn-secondary" onclick="browseFolder('pipeline-input-img-dir')">娴忚</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">杈撳嚭鏍圭洰褰?<span class="badge-required">蹇呭～</span></label>
                            <div class="input-with-btn">
                                <input type="text" id="pipeline-output-dir" class="form-input" placeholder="鍚勬楠よ緭鍑哄皢鑷姩鍒涘缓瀛愮洰褰?>
                                <button type="button" class="btn-secondary" onclick="browseFolder('pipeline-output-dir')">娴忚</button>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">杈撳嚭鏂囦欢鍚?/label>
                                <input type="text" id="pipeline-filename" class="form-input" value="merged" placeholder="姝ラ1杈撳嚭鏂囦欢鍚?>
                            </div>
                            <div class="form-group">
                                <label class="form-label">鍒嗕綅鏁扮被鍒暟</label>
                                <input type="number" id="pipeline-num-classes" class="form-input" value="5" min="2" max="20">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">
                                <input type="checkbox" id="pipeline-adjust-sizes" checked> 鑷姩璋冩暣涓嶅悓灏哄鐨凜SV鏂囦欢
                            </label>
                        </div>
                    </div>

                    <!-- 鈹€鈹€ 鏁版嵁棰勫鐞嗛厤缃紙姝ラ1 + 姝ラ2锛?鈹€鈹€ -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                鏁版嵁棰勫鐞嗛厤缃?                                <span class="text-muted text-sm">姝ラ1 & 姝ラ2</span>
                            </h3>
                        </div>

                        <!-- 姝ラ1锛氭尝娈靛垹闄?-->
                        <div class="pipeline-subsection">
                            <div class="pipeline-subsection-title">
                                <span class="step-badge">1</span>
                                娉㈡鑼冨洿鍒犻櫎
                                <span class="text-muted text-sm" style="margin-left: auto;">鍙€?/span>
                            </div>
                            <div class="radio-group" id="pipeline-delete-mode">
                                <div class="radio-option active" data-value="default" onclick="setPipelineDeleteMode(this, 'default')">
                                    浣跨敤榛樿锛堜笉鍒犻櫎锛?                                </div>
                                <div class="radio-option" data-value="custom" onclick="setPipelineDeleteMode(this, 'custom')">
                                    鑷畾涔夊垹闄よ寖鍥?                                </div>
                            </div>
                            <div id="pipeline-custom-delete-section" style="display:none; margin-top: 0.75rem;">
                                <div id="pipeline-delete-ranges"></div>
                                <button type="button" class="btn-secondary btn-sm" onclick="addPipelineDeleteRange()" style="margin-top: 0.5rem;">+ 娣诲姞娉㈡鑼冨洿</button>
                            </div>
                        </div>

                        <div class="pipeline-divider"></div>

                        <!-- 姝ラ2锛氭牱鏈厤缃?-->
                        <div class="pipeline-subsection">
                            <div class="pipeline-subsection-title">
                                <span class="step-badge">2</span>
                                鏍锋湰閰嶇疆
                                <span class="badge-required" style="margin-left: 0.5rem;">蹇呭～</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">SHP鏍锋湰璺緞 <span class="badge-required">蹇呭～</span></label>
                                <div class="input-with-btn">
                                    <input type="text" id="pipeline-shp-input" class="form-input" placeholder="SHP鏂囦欢鎴栨枃浠跺す璺緞">
                                    <button type="button" class="btn-secondary" onclick="browseFolder('pipeline-shp-input')">娴忚</button>
                                </div>
                                <p class="form-hint">褰卞儚鏂囦欢灏嗕粠涓婃柟銆屽奖鍍忔枃浠跺す璺緞銆嶄腑鑷姩閫夊彇</p>
                            </div>
                        </div>
                    </div>

                    <!-- 鈹€鈹€ 鍖归厤涓庤浆鎹㈤厤缃紙姝ラ3 + 姝ラ4锛?鈹€鈹€ -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M16 3h5v5"/><path d="M8 21H3v-5"/><path d="M21 3l-9 9"/><path d="M3 21l9-9"/></svg>
                                鍖归厤涓庤浆鎹㈤厤缃?                                <span class="text-muted text-sm">姝ラ3 & 姝ラ4</span>
                            </h3>
                        </div>

                        <!-- 姝ラ3锛氬尮閰嶉厤缃?-->
                        <div class="pipeline-subsection">
                            <div class="pipeline-subsection-title">
                                <span class="step-badge">3</span>
                                姹夋槑璺濈鍖归厤
                                <span class="badge-required" style="margin-left: 0.5rem;">蹇呭～</span>
                            </div>
                            <!-- 鐩爣CSV鏂囦欢锛氳嚜鍔ㄦ帹瀵硷紝鏃犻渶鐢ㄦ埛杈撳叆 -->
                            <div class="form-group">
                                <label class="form-label">鐩爣CSV鏂囦欢 <span class="badge-required">蹇呭～</span></label>
                                <div class="input-with-btn" style="opacity:0.7;">
                                    <input type="text" id="pipeline-target-file" class="form-input" readonly placeholder="鑷姩鎺ㄥ锛氳緭鍑烘牴鐩綍/step1/鏂囦欢鍚?csv">
                                    <button type="button" class="btn-secondary" disabled>鑷姩</button>
                                </div>
                                <p class="form-hint">鐢便€岃緭鍑烘牴鐩綍銆嶅拰銆岃緭鍑烘枃浠跺悕銆嶈嚜鍔ㄦ帹瀵硷紝鍗?杈撳嚭鏍圭洰褰?step1/鏂囦欢鍚?csv</p>
                            </div>

                            <!-- 鑷姩鏇挎崲鍊奸瑙堝尯鍩?-->
                            <div id="pipeline-replacement-preview-section" style="display:none; margin: 1rem 0;">
                                <div class="card-header" style="padding: 0.75rem 1rem; background: var(--bg-secondary); border-radius: 8px 8px 0 0; border-bottom: 1px solid var(--border-color);">
                                    <h4 style="margin: 0; font-size: 0.9rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
                                        鑷姩鏇挎崲鍊奸瑙?                                        <span id="pipeline-classes-count" style="font-weight: normal;"></span>
                                    </h4>
                                </div>
                                <div id="pipeline-replacement-preview" style="padding: 0.75rem 1rem; background: var(--bg-tertiary); border-radius: 0 0 8px 8px; max-height: 200px; overflow-y: auto;">
                                    <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0;">鍔犺浇涓?..</p>
                                </div>
                                <p class="form-hint" style="margin-top: 0.5rem;">
                                    绋嬪簭灏嗘牴鎹娴嬪埌鐨勬牱鏈被鍨嬫暟閲忚嚜鍔ㄥ垎閰嶆浛鎹㈠€硷紝姣忚疆杩唬渚濇閫掑銆?                                    渚嬪锛?涓被鍒?鈫?绗?杞娇鐢?-4锛岀2杞娇鐢?-8锛屼互姝ょ被鎺ㄣ€?                                </p>
                            </div>

                            <div class="form-group">
                                <label class="form-label">姹夋槑璺濈鍒濆闃堝€?/label>
                                <div style="display:flex; align-items:center; gap:0.75rem;">
                                    <input type="number" id="pipeline-initial-threshold" class="form-input"
                                        value="0" min="0" step="1" style="width:120px;">
                                    <span style="color:var(--text-muted); font-size:0.85rem;">姣忚疆鑷姩 +5锛堢1杞?0锛岀2杞?5锛岀3杞?10锛屸€︹€︼級</span>
                                </div>
                                <p class="form-hint">棣栬疆浣跨敤鍒濆闃堝€硷紝鍚庣画姣忚疆閫掑5锛屾棤闇€鎵嬪姩閰嶇疆鍚勮疆闃堝€?/p>
                            </div>
                        </div>

                        <div class="pipeline-divider"></div>

                        <!-- 姝ラ4锛欵NVI杞崲 -->
                        <div class="pipeline-subsection">
                            <div class="pipeline-subsection-title">
                                <span class="step-badge">4</span>
                                ENVI鏍煎紡杞崲
                            </div>
                            <div class="form-group">
                                <label class="form-label">
                                    <input type="checkbox" id="pipeline-add-geo" checked> 娣诲姞鍦扮悊鍧愭爣淇℃伅
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="form-label">鏈€澶у簭鍒楅暱搴﹁繃婊?<span class="text-muted text-sm">锛堝彲閫夛級</span></label>
                                <input type="number" id="pipeline-max-seq-length" class="form-input" placeholder="鐣欑┖琛ㄧず涓嶉檺鍒?>
                            </div>
                        </div>
                    </div>

                    <!-- 鈹€鈹€ 鍒嗙被涓庨獙璇侀厤缃紙姝ラ5 + 姝ラ6锛?鈹€鈹€ -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 3v18"/><rect x="4" y="8" width="6" height="12" rx="1"/><rect x="14" y="4" width="6" height="16" rx="1"/></svg>
                                鍒嗙被涓庨獙璇侀厤缃?                                <span class="text-muted text-sm">姝ラ5 & 姝ラ6</span>
                            </h3>
                        </div>

                        <!-- 姝ラ5锛氬湴鐗╃被鍒?-->
                        <div class="pipeline-subsection">
                            <div class="pipeline-subsection-title">
                                <span class="step-badge">5</span>
                                鍦扮墿绫诲埆瀹氫箟
                                <span class="badge-required" style="margin-left: 0.5rem;">蹇呭～</span>
                            </div>
                            <div id="pipeline-classes">
                                <div class="dynamic-item class-item">
                                    <div class="class-item-row">
                                        <input type="text" class="class-name" placeholder="类别名称（如：水体）" value="水体" style="flex:2;">
                                        <input type="text" class="class-values" placeholder="数值列表（如：1,2,3）" value="1,2" style="flex:2;">
                                    </div>
                                    <button type="button" class="btn-icon" onclick="this.parentElement.remove()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                                </div>
                                <div class="dynamic-item class-item">
                                    <div class="class-item-row">
                                        <input type="text" class="class-name" placeholder="类别名称" value="人工表面" style="flex:2;">
                                        <input type="text" class="class-values" placeholder="数值列表" value="3,4" style="flex:2;">
                                    </div>
                                    <button type="button" class="btn-icon" onclick="this.parentElement.remove()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                                </div>
                                <div class="dynamic-item class-item">
                                    <div class="class-item-row">
                                        <input type="text" class="class-name" placeholder="类别名称" value="林地" style="flex:2;">
                                        <input type="text" class="class-values" placeholder="数值列表" value="5,6" style="flex:2;">
                                    </div>
                                    <button type="button" class="btn-icon" onclick="this.parentElement.remove()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                                </div>
                                <div class="dynamic-item class-item">
                                    <div class="class-item-row">
                                        <input type="text" class="class-name" placeholder="类别名称" value="耕地" style="flex:2;">
                                        <input type="text" class="class-values" placeholder="数值列表" value="7,8" style="flex:2;">
                                    </div>
                                    <button type="button" class="btn-icon" onclick="this.parentElement.remove()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                                </div>
                            </div>
                            <button type="button" class="btn-secondary btn-sm" onclick="addPipelineClass()" style="margin-top:0.5rem;">+ 添加类别</button>
                            <p class="form-hint" style="margin-top:0.5rem;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12" style="display:inline;vertical-align:middle;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                冻结策略（全局固定）：每类连续 2 轮 PA 增幅 &lt; 0.5% 时自动冻结，冻结后不再参与汉明距离匹配。
                            </p>
                        </div>

                        <div class="pipeline-divider"></div>

                        <!-- 姝ラ6锛氱簿搴﹁瘎浠?-->
                        <div class="pipeline-subsection">
                            <div class="pipeline-subsection-title">
                                <span class="step-badge">6</span>
                                绮惧害璇勪环閰嶇疆
                                <span class="badge-required" style="margin-left: 0.5rem;">蹇呭～</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">楠岃瘉SHP鏂囦欢澶?<span class="badge-required">蹇呭～</span></label>
                                <div class="input-with-btn">
                                    <input type="text" id="pipeline-shp-folder" class="form-input" placeholder="楠岃瘉鏍锋湰SHP鏂囦欢澶硅矾寰?>
                                    <button type="button" class="btn-secondary" onclick="browseFolder('pipeline-shp-folder')">娴忚</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 鈹€鈹€ 杩唬鎺у埗鍙傛暟 鈹€鈹€ -->
                    <div class="card card-iteration">
                        <div class="card-header">
                            <h3 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
                                杩唬鎺у埗 路 缁堟鏉′欢
                            </h3>
                        </div>
                        <p class="form-hint" style="margin-bottom:1rem;">
                            姝ラ3-6 灏嗗惊鐜凯浠ｏ紝姣忚疆瀹屾垚绮惧害璇勪环鍚庝緷娆″垽鏂粓姝㈡潯浠讹細<br>
                            鈶?Kappa绯绘暟 鈮?闃堝€?鈫?缁堟 &nbsp;|&nbsp; 鈶?鏈垎绫诲儚绱犳瘮渚?鈮?闃堝€?鈫?缁堟 &nbsp;|&nbsp; 鈶?绫诲埆杈惧埌鍐荤粨鏉′欢 鈫?璇ョ被鍒笉鍐嶅弬涓庡悗缁尮閰?&nbsp;|&nbsp; 鈶?杈惧埌鏈€澶ц疆娆?鈫?寮哄埗缁堟
                        </p>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
                                    Kappa 缁堟闃堝€?                                </label>
                                <input type="number" id="pipeline-kappa-threshold"
                                       class="form-input" value="0.8" min="0" max="1" step="0.01"
                                       placeholder="0.80">
                                <p class="form-hint">Kappa 鈮?姝ゅ€兼椂缁堟锛堥粯璁?0.80锛?/p>
                            </div>
                            <div class="form-group">
                                <label class="form-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                    鏈垎绫诲儚绱犳瘮渚嬮槇鍊硷紙%锛?                                </label>
                                <input type="number" id="pipeline-unclassified-threshold"
                                       class="form-input" value="10" min="0" max="100" step="0.5"
                                       placeholder="10.0">
                                <p class="form-hint">鏈垎绫诲儚绱?鈮?姝ゆ瘮渚嬫椂缁堟锛堥粯璁?10%锛?/p>
                            </div>
                            <div class="form-group">
                                <label class="form-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    鏈€澶ц凯浠ｈ疆娆?                                </label>
                                <input type="number" id="pipeline-max-iterations"
                                       class="form-input" value="10" min="1" max="50" step="1"
                                       placeholder="10">
                                <p class="form-hint">杈惧埌姝よ疆娆″悗寮哄埗缁堟锛堥粯璁?10锛?/p>
                            </div>
                        </div>
                    </div>

                </div><!-- /step-grid -->

                <!-- 鎵ц鎸夐挳 -->
                <div style="margin-top: 1.5rem; display: flex; justify-content: center;">
                    <button id="pipeline-run-btn" class="btn-primary btn-lg" onclick="runPipeline()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        鍚姩鍏ㄦ祦绋嬪鐞?                    </button>
                </div>

                <!-- 鏈€缁堢粨鏋滈潰鏉?-->
                <!-- 杞杩唬鍘嗗彶琛?-->
                <div id="pipeline-rounds-section" style="display:none; margin-top: 1.5rem;">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
                                鍚勮疆娆¤瘎浠风粨鏋?                            </h3>
                        </div>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>杞</th>
                                    <th>姹夋槑闃堝€?/th>
                                    <th>Kappa 绯绘暟</th>
                                    <th>鎬讳綋绮惧害 OA</th>
                                    <th>鏈垎绫诲儚绱犳瘮渚?/th>
                                    <th>鏇挎崲鍊?/th>
                                    <th>绫诲埆鐘舵€?/th>
                                    <th>缁堟</th>
                                </tr>
                            </thead>
                            <tbody id="pipeline-rounds-history"></tbody>
                        </table>
                    </div>
                </div>

                <!-- 鏈€缁堢簿搴︾粨鏋滈潰鏉?-->
                <div id="pipeline-results" style="display:none; margin-top: 1.5rem;">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">鏈€缁堣疆绮惧害璇勪环缁撴灉</h3>
                        </div>
                        <div class="stats-row" style="display:flex; gap:1rem; margin-bottom:1rem; flex-wrap:wrap;">
                            <div class="stat-card" style="flex:1; min-width:120px;">
                                <div class="stat-value" id="pipeline-oa">--</div>
                                <div class="stat-label">鎬讳綋绮惧害 OA</div>
                            </div>
                            <div class="stat-card" style="flex:1; min-width:120px;">
                                <div class="stat-value" id="pipeline-kappa">--</div>
                                <div class="stat-label">Kappa 绯绘暟</div>
                            </div>
                            <div class="stat-card" style="flex:1; min-width:120px;">
                                <div class="stat-value" id="pipeline-pixels">--</div>
                                <div class="stat-label">鎬诲儚绱犳暟</div>
                            </div>
                        </div>
                        <table class="data-table">
                            <thead>
                                <tr><th>绫诲埆</th><th>鐢熶骇鑰呯簿搴?/th><th>鐢ㄦ埛绮惧害</th></tr>
                            </thead>
                            <tbody id="pipeline-class-accuracies"></tbody>
                        </table>
                    </div>
                    <!-- 杈撳嚭璺緞姹囨€?-->
                    <div class="card" style="margin-top:1rem;">
                        <div class="card-header">
                            <h3 class="card-title">杈撳嚭鏂囦欢璺緞</h3>
                        </div>
                        <div id="pipeline-outputs" class="output-paths-list"></div>
                    </div>
                </div>

            </div><!-- /page-pipeline -->

        </main>
    </div>

    <!-- Task Monitor -->
    <div class="task-monitor" id="task-monitor">
        <div class="task-monitor-header">
            <span>澶勭悊涓?/span>
            <button onclick="hideTaskMonitor()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <div class="task-monitor-body">
            <div id="task-monitor-content">
                <div class="task-monitor-status">鍑嗗灏辩华</div>
                <div class="progress-bar" style="margin-top: 0.5rem;">
                    <div class="progress-fill" style="width: 0%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/static/js/config.js"></script>
    <script src="/static/js/navigation.js"></script>
    <script src="/static/js/api.js"></script>
    <script src="/static/js/forms.js"></script>
    <script src="/static/js/steps.js"></script>
    <script src="/static/js/pipeline.js"></script>
    <script src="/static/js/app.js"></script>
</body>
</html>
