                            </div>
                            <div class="metric-item">
                                <div class="metric-value" id="step6-pixels">--</div>
                                <div class="metric-label">鎬诲儚绱犳暟</div>
                            </div>
                        </div>
                        <div class="table-container" style="margin-top: 1.5rem;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>绫诲埆</th>
                                        <th>鐢熶骇鑰呯簿搴?/th>
                                        <th>鐢ㄦ埛绮惧害</th>
                                    </tr>
                                </thead>
                                <tbody id="step6-class-accuracies"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- Pipeline Page - 鍏ㄦ祦绋嬪鐞?                -->
            <!-- ========================================== -->
            <div id="page-pipeline" class="page">
                <div class="page-header">
                    <h2 class="page-title">涓€閿叏娴佺▼澶勭悊</h2>
                    <p class="page-desc">鑷姩涓茶仈姝ラ1-6锛屽墠涓€闃舵杈撳嚭鍗充负涓嬩竴闃舵杈撳叆</p>
                </div>

                <!-- 鎬昏繘搴﹂潰鏉匡紙鍒濆闅愯棌锛?-->
                <div id="pipeline-progress-section" style="display:none; margin-bottom: 1.5rem;">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">鎵ц杩涘害</h3>
                            <span id="pipeline-current-round-label" class="text-muted text-sm" style="margin-left:auto; margin-right:0.75rem;"></span>
