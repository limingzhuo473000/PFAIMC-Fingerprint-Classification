                                    <div class="pipeline-step-name">鏍锋湰杩涢樁鍒嗘瀽</div>
                                    <div class="pipeline-step-msg"></div>
                                </div>
                                <div class="pipeline-step-right">
                                    <div class="pipeline-step-status">绛夊緟涓?/div>
                                    <div class="progress-bar pipeline-step-bar">
                                        <div class="progress-fill pipeline-step-progress-fill" style="width:0%"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="pipeline-step-card" id="pipeline-step-3">
                                <div class="pipeline-step-num">03</div>
                                <div class="pipeline-step-info">
                                    <div class="pipeline-step-name">姹夋槑璺濈鍖归厤</div>
                                    <div class="pipeline-step-msg"></div>
                                </div>
                                <div class="pipeline-step-right">
                                    <div class="pipeline-step-status">绛夊緟涓?/div>
                                    <div class="progress-bar pipeline-step-bar">
                                        <div class="progress-fill pipeline-step-progress-fill" style="width:0%"></div>
                                    </div>
                                </div>
