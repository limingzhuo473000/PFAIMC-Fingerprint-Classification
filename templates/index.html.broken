                        </div>
                        <div class="progress-bar" style="margin-bottom: 0.5rem;">
                            <div class="progress-fill" id="pipeline-total-progress-fill" style="width:0%"></div>
                        </div>
                        <div id="pipeline-total-status" class="text-muted text-sm">绛夊緟寮€濮?..</div>

                        <!-- 缁堟鍘熷洜妯箙 -->
                        <div id="pipeline-stop-banner" class="pipeline-stop-banner" style="display:none;"></div>

                        <!-- 6姝ラ鐘舵€佸崱鐗?-->
